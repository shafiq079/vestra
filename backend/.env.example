# VESTRA backend — example environment configuration
#
# Copy this file to `backend/.env` and fill in real values for local development:
#
#   cd backend && cp .env.example .env
#
# `.env` is git-ignored and must NEVER be committed. This file documents variable
# NAMES and PURPOSE only — every value below is a placeholder or a safe local default.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# Node runtime mode. One of: development | test | production
NODE_ENV=development

# Port the Express server binds to.
# 5000 is required for local development because the frontend defaults to
# http://localhost:5000/api (see frontend/src/services/apiClient.ts).
# On a managed host (e.g. Render) this is supplied by the platform.
# Do not set a fixed production value in Render; its injected PORT is authoritative.
PORT=5000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# MongoDB connection string (MongoDB Atlas in every deployed environment).
# Placeholder below — replace the angle-bracket parts with your own cluster
# details in `.env`. Never commit a real credential to the repository.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database-name>?retryWrites=true&w=majority

# ---------------------------------------------------------------------------
# HTTP / CORS
# ---------------------------------------------------------------------------

# Comma-separated list of browser origins permitted by CORS.
# The value below is the Vite dev-server origin used by frontend/.
# A wildcard ("*") is rejected outright when NODE_ENV=production.
# In Render, set this to the exact HTTPS Vercel production origin (no trailing
# slash). Multiple explicit origins may be supplied as a comma-separated list.
CORS_ORIGIN=http://localhost:5173

# Authentication. JWT_SECRET must be a random value of at least 32 characters.
JWT_SECRET=<random-secret-at-least-32-characters>
# Access-token lifetime in seconds; bcrypt work factor; refresh lifetime in days.
JWT_ACCESS_TTL_SECONDS=900
BCRYPT_ROUNDS=12
REFRESH_TOKEN_TTL_DAYS=7
# Optional at API boot; required only by `npm run seed:demo-users`.
DEMO_CUSTOMER_PASSWORD=<demo-customer-password>
DEMO_ADMIN_PASSWORD=<demo-admin-password>

# ---------------------------------------------------------------------------
# Phase 10 — Cloudinary + Pixelcut Virtual Try-On
# ---------------------------------------------------------------------------

# Newly issued Pixelcut server credential. Never use a VITE_ variable for it.
PIXELCUT_API_KEY=<pixelcut-server-api-key>

# Cloudinary server credentials. Temporary customer photos use private delivery;
# catalogue uploads use authenticated backend uploads. Browser-unsigned presets
# are not used.
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>

# Per-owner started jobs per UTC day and simultaneously active jobs.
VTO_DAILY_QUOTA=5
VTO_CONCURRENT_LIMIT=1
# Submission rate limit (separate from daily and concurrent quota).
VTO_RATE_LIMIT_WINDOW_SECONDS=60
VTO_RATE_LIMIT_MAX_REQUESTS=5
# Pixelcut HTTP timeout, overall job deadline, private source URL lifetime, and
# abandoned-job/failed-deletion reconciliation interval.
VTO_PROVIDER_TIMEOUT_MS=10000
VTO_JOB_DEADLINE_SECONDS=600
VTO_SOURCE_URL_TTL_SECONDS=900
VTO_RECONCILE_INTERVAL_SECONDS=60
