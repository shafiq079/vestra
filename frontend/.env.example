# Real API mode. Set true to run the complete offline demonstration instead.
VITE_USE_MOCK_API=false
VITE_API_BASE_URL=http://localhost:5000/api

# Optional credentials for the deliberately public dissertation demo accounts.
# These must match the backend demo-user seed values for one-click real-mode login.
VITE_DEMO_CUSTOMER_PASSWORD=<demo-customer-password>
VITE_DEMO_ADMIN_PASSWORD=<demo-admin-password>
